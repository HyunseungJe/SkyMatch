float world_hash12(float2 p) {
  float3 q = frac(((float3)(p.xyx)) * 0.1031);
  q += dot(q, q.yzx + 33.33);
  return frac((q.x + q.y) * q.z);
}
float world_hash13(float3 p) {
  p = frac(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return frac((p.x + p.y) * p.z);
}
float world_noise2(float2 p) {
  float2 i = floor(p), f = frac(p); f = f * f * (3.0 - 2.0 * f);
  return lerp(lerp(world_hash12(i), world_hash12(i + float2(1,0)), f.x),
    lerp(world_hash12(i + float2(0,1)), world_hash12(i + float2(1,1)), f.x), f.y);
}
float world_noise3(float3 p) {
  float3 i = floor(p), f = frac(p); f = f * f * (3.0 - 2.0 * f);
  return lerp(lerp(lerp(world_hash13(i), world_hash13(i + float3(1,0,0)), f.x),
                 lerp(world_hash13(i + float3(0,1,0)), world_hash13(i + float3(1,1,0)), f.x), f.y),
             lerp(lerp(world_hash13(i + float3(0,0,1)), world_hash13(i + float3(1,0,1)), f.x),
                 lerp(world_hash13(i + float3(0,1,1)), world_hash13(i + float3(1,1,1)), f.x), f.y), f.z);
}
float world_fbm2(float2 p, int octaves) {
  float value = 0.0, weight = 0.5, total = 0.0;
  for (int i = 0; i < 8; ++i) { if (i >= octaves) break;
    value += weight * world_noise2(p); total += weight; p = p * 2.03 + 17.1; weight *= 0.5;
  }
  return value / max(total, 0.0001);
}
float world_fbm3(float3 p, int octaves) {
  float value = 0.0, weight = 0.5, total = 0.0;
  for (int i = 0; i < 8; ++i) { if (i >= octaves) break;
    value += weight * world_noise3(p); total += weight; p = p * 2.03 + 17.1; weight *= 0.5;
  }
  return value / max(total, 0.0001);
}


