// Hand port of frozen sky/skyV1.glsl (schema 1.0), linear Rec.709 HDR.
// Same function names, constants, expression order and 96-step cloud march.
// OSL adaptation: vec2 uses vector.xy; the cloud vec4 uses CloudResult.
// No external shader code, built-in noise, derivatives or 3D textures.
#define PI 3.14159265359
// Round before fract: LLVM otherwise contracts the preceding multiplication
// with subtraction, changing the float32 hash (and thus the star catalogue).
float fp32(float x) {
  return floor(x*79228162514264337593543950336.0)*1.262177448353619e-29;
}
// Match GLSL/NVIDIA's nested fused dot while retaining float32 intermediate
// rounding under OSL/LLVM. Dekker products recover the residual before one
// final rounding; hash arguments are bounded and positive after fract.
float reference_fma(float a,float b,float c) {
  float p=fp32(a*b);
  float ca=fp32(4097.0*a), ah=fp32(ca-fp32(ca-a)), al=fp32(a-ah);
  float cb=fp32(4097.0*b), bh=fp32(cb-fp32(cb-b)), bl=fp32(b-bh);
  float error=fp32(fp32(fp32(fp32(ah*bh)-p)+fp32(ah*bl))+fp32(al*bh));
  error=fp32(error+fp32(al*bl));
  float total=fp32(p+c);
  float residual=p>=c ? fp32(fp32(p-total)+c) : fp32(fp32(c-total)+p);
  return fp32(total+fp32(error+residual));
}
float reference_dot(vector a,vector b) {
  return reference_fma(a[2],b[2],reference_fma(a[1],b[1],fp32(a[0]*b[0])));
}
float fract(float x) { float f=fp32(x); return fp32(f-floor(f)); }
vector fract(vector x) { return vector(fract(x[0]),fract(x[1]),fract(x[2])); }
vector v2(float x,float y) { return vector(x,y,0); }
vector v2(float x) { return vector(x,x,0); }
vector pack(vector xy,float z) { return vector(xy[0],xy[1],z); }
float dot2(vector a,vector b) { return a[0]*b[0]+a[1]*b[1]; }
float length2(vector a) { return sqrt(dot2(a,a)); }
struct CloudResult { vector rgb; float a; };
CloudResult cloudResult(vector rgb,float a) { CloudResult c; c.rgb=rgb; c.a=a; return c; }
struct SkyState {
  float sunElevation;
  float sunAzimuth;
  float haze;
  float horizonWarmth;
  vector zenithColor;
  vector horizonColor;
  vector sunGlowColor;
  float cloudCover;
  float cloudDensity;
  float cloudScale;
  float cloudSoftness;
  float storm;
  float stars;
  float moonElevation;
  float moonAzimuth;
  float moonBrightness;
  float nightBrightness;
  int nightEffect;
  float milkyWayBrightness;
  float auroraIntensity;
  float auroraHue;
  float milkyWayTilt;
  float milkyWayAzimuth;
  float milkyWayWidth;
  float auroraAzimuth;
  float auroraSpread;
  float auroraHeight;
  float auroraSpeed;
  float cloudSpeed;
  float cloudWindDirection;
  float time;
  string noiseTexture;
};

// Filename textures are raw data, bilinear, LOD 0 (explicit zero derivatives).
// Cycles ignores periodic wrapping: wrap manually and add clipped edge lobes.
// GL PNG row zero is the first row; Blender texture V starts at the bottom.
color skyV1_fetch(SkyState s,float u_in,float v_in) {
  float u=fract(u_in), v=fract(v_in);
  float du=u<0.5?1.0:-1.0, dv=v<0.5?1.0:-1.0;
  int seam_u=u<0.001953125 || u>0.998046875;
  int seam_v=v<0.001953125 || v>0.998046875;
  color c=texture(s.noiseTexture,u,1.0-v,0.0,0.0,0.0,0.0,"interp","bilinear");
  if(seam_u)c+=texture(s.noiseTexture,u+du,1.0-v,0.0,0.0,0.0,0.0,"interp","bilinear");
  if(seam_v)c+=texture(s.noiseTexture,u,1.0-v-dv,0.0,0.0,0.0,0.0,"interp","bilinear");
  if(seam_u && seam_v)c+=texture(s.noiseTexture,u+du,1.0-v-dv,0.0,0.0,0.0,0.0,"interp","bilinear");
  return c;
}
float world_hash12(vector p) {
  vector q = fract(vector(p[0],p[1],p[0]) * 0.1031);
  q += reference_dot(q, vector(fp32(q[1]+33.33),fp32(q[2]+33.33),fp32(q[0]+33.33)));
  return fract((q[0] + q[1]) * q[2]);
}
float world_hash13(vector p_in) {
  vector p = p_in;
  p = fract(p * 0.1031);
  p += reference_dot(p, vector(fp32(p[2]+31.32),fp32(p[1]+31.32),fp32(p[0]+31.32)));
  return fract((p[0] + p[1]) * p[2]);
}
float world_noise2(vector p) {
  vector i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(world_hash12(i), world_hash12(i + v2(1,0)), f[0]),
    mix(world_hash12(i + v2(0,1)), world_hash12(i + v2(1,1)), f[0]), f[1]);
}
float world_noise3(vector p) {
  vector i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(world_hash13(i), world_hash13(i + vector(1,0,0)), f[0]),
                 mix(world_hash13(i + vector(0,1,0)), world_hash13(i + vector(1,1,0)), f[0]), f[1]),
             mix(mix(world_hash13(i + vector(0,0,1)), world_hash13(i + vector(1,0,1)), f[0]),
                 mix(world_hash13(i + vector(0,1,1)), world_hash13(i + vector(1,1,1)), f[0]), f[1]), f[2]);
}
float world_fbm2(vector p_in, int octaves) {
  vector p = p_in;
  float value = 0.0, weight = 0.5, total = 0.0;
  for (int i = 0; i < 8; ++i) { if (i >= octaves) break;
    value += weight * world_noise2(p); total += weight; p = p * 2.03 + 17.1; weight *= 0.5;
  }
  return value / max(total, 0.0001);
}
float world_fbm3(vector p_in, int octaves) {
  vector p = p_in;
  float value = 0.0, weight = 0.5, total = 0.0;
  for (int i = 0; i < 8; ++i) { if (i >= octaves) break;
    value += weight * world_noise3(p); total += weight; p = p * 2.03 + 17.1; weight *= 0.5;
  }
  return value / max(total, 0.0001);
}


